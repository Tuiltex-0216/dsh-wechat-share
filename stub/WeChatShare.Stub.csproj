<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- T1: Library (no Main yet); T2 adds Program.cs and flips this to Exe. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WeChatShare.Stub</AssemblyName>
    <RootNamespace>WeChatShare.Stub</RootNamespace>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- .NET 5+ cannot reference Windows winmd directly (NETSDK1130);
         CsWinRT generates the C# projection from the SDK at build time. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
  </ItemGroup>
  <ItemGroup>
    <CsWinRTIncludes Include="Windows.ApplicationModel" />
    <CsWinRTIncludes Include="Windows.Storage" />
  </ItemGroup>

</Project>
