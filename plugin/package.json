{
  "name": "dsh-wechat-share",
  "version": "1.0.0",
  "description": "WeChat share-target inbox → DSH session delivery (zip attachment)",
  "type": "module",
  "private": true,
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "package.json"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.1-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
